{
  "name": "psyche-core",
  "private": true,
  "version": "1.1.0",
  "description": "Psyche Core \u2014 PRISM self-reflection app (static, no build step)",
  "scripts": {
    "test": "node tests/run-all.js",
    "psychometrics": "node tools/psychometrics.js",
    "design-analysis": "node tools/design-analysis.js --out ../docs/ASSESSMENT_DESIGN_ANALYSIS.md",
    "item-review": "node tools/gen-item-review.js",
    "test:e2e": "node tests/e2e/keyboard.js && node tests/e2e/audit.js --strict && node tests/e2e/security.js",
    "serve": "python3 -m http.server 8000",
    "test:security": "node tests/security.test.js",
    "perf": "node tools/perf-budget.js",
    "snapshot": "node tools/eval-run.js",
    "snapshot:update": "node tools/eval-run.js --update",
    "review-sheet": "node tools/review-sheet.js",
    "review-score": "node tools/review-score.js",
    "gates": "node tools/release-gates.js",
    "gates:report": "node tools/release-gates.js --report --out ../docs/RELEASE_STATUS.md"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "jsdom": "^24.1.0",
    "playwright-core": "^1.49.1"
  }
}